
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Transaction {
    id              String      @id @default(uuid())
    userId          String
    name            String
    amount          Float
    category        String
    date            DateTime
    createdAt       DateTime    @default(now())

    @@index([userId])
    @@index([userId, date])
}

model Pot {
    id              String      @id @default(uuid())
    userId          String
    name            String
    targetAmount    Float
    currentAmount   Float       @default(0)
    createdAt       DateTime    @default(now())

    @@index([userId])
}

model RecurringBill {
    id              String      @id @default(uuid())
    userId          String
    name            String
    amount          Float
    category        String
    dueDate         Int
    isPaid          Boolean     @default(false)
    active          Boolean     @default(true)
    createdAt       DateTime    @default(now())

    @@index([userId])
}
